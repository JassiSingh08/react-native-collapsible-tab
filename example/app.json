{
  "expo": {
    "name": "Collapsing Tabs Example",
    "slug": "react-native-collapsing-tabs-example",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jass08.react-native-collapsing-tabs-example"
    },
    "android": {
      "package": "com.jass08.reactnativecollapsingtabsexample"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ]
  }
}
